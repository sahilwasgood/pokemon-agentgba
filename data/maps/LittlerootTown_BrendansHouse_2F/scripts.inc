PlayersBedroom_EventScript_DevNpc::
	lock
	faceplayer
	goto_if_set FLAG_GOT_DEV_MEWTWO, PlayersBedroom_EventScript_DevAlready
	msgbox PlayersBedroom_Text_DevAsk, MSGBOX_YESNO
	compare VAR_RESULT, NO
	goto_if_eq PlayersBedroom_EventScript_DevNo
	@ ---- DEV GIFT: every legendary / mythical / Ultra Beast in the game ----
	@ Lv100, 252 EVs in every stat, 31 IVs, nice neutral nature.
	@ Moves: signature move(s) first, then the strongest STAB/coverage
	@ from that species' own learnset. First six fill the party, rest go to the PC.
	@ Field moves: Cut is gated on the Stone Badge (src/field_move.c) and
	@ Groudon is the only party mon that can learn it, so grant both.
	setflag FLAG_BADGE01_GET
	setflag FLAG_BADGE02_GET
	setflag FLAG_BADGE03_GET
	setflag FLAG_BADGE04_GET
	setflag FLAG_BADGE05_GET
	setflag FLAG_BADGE06_GET
	setflag FLAG_BADGE07_GET
	setflag FLAG_BADGE08_GET
